# Copy this file to .env.production and fill in real values before deploying.
# docker-compose.prod.yml loads this file into the app container as-is.
#
# This setup connects to an EXTERNAL MySQL server (not a bundled container).
# - If MySQL runs on the same Docker host (e.g. your existing local/native
#   install), set DB_HOST=host.docker.internal.
# - If MySQL is a separate server, use its real hostname/IP.

APP_NAME=Tyro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=TyroHrm
DB_USERNAME=root
DB_PASSWORD=change-me

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Set to true only for the first deploy / after a migration is committed.
RUN_MIGRATIONS=false
